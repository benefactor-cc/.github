{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benefactor-cc/.github/blob/main/architecture/platform-integrations.schema.json",
  "title": "Benefactor platform integration policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "organization",
    "audited_at",
    "capabilities",
    "role_requirements"
  ],
  "properties": {
    "$schema": { "const": "./platform-integrations.schema.json" },
    "schema_version": { "const": 1 },
    "organization": { "const": "benefactor-cc" },
    "audited_at": { "type": "string", "format": "date" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observability", "sync", "authentication", "dependencies"],
      "properties": {
        "observability": { "$ref": "#/$defs/capability" },
        "sync": { "$ref": "#/$defs/capability" },
        "authentication": { "$ref": "#/$defs/capability" },
        "dependencies": { "$ref": "#/$defs/capability" }
      }
    },
    "role_requirements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": ["observability", "sync", "authentication", "dependencies"]
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "audited_revision",
        "package_coordinates",
        "resolution_state",
        "invariants"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "audited_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "package_coordinates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@\\^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "resolution_state": {
          "enum": ["installable", "pending-public-registry"]
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
